# ==============================================================================
# ZUHURA MARS DIGITAL TWIN - ENVIRONMENT CONFIGURATION
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL & PostGIS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zuhura
POSTGRES_USER=zuhura_user
# Development default only. Replace before ENVIRONMENT=production.
POSTGRES_PASSWORD=zuhura_secure_password
DATABASE_URL=postgresql+asyncpg://zuhura_user:zuhura_secure_password@postgres:5432/zuhura

# Redis Cache & Task Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=zuhura_minio_admin
MINIO_ROOT_PASSWORD=zuhura_minio_secret_key
STORAGE_BUCKET_TILES=zuhura-tiles
STORAGE_BUCKET_TERRAIN=zuhura-terrain
STORAGE_BUCKET_COGS=zuhura-cogs

# Planetary & Geodetic Reference Constants (IAU/IAG 2015 WGCCRE)
MARS_SEMI_MAJOR_RADIUS_M=3396190.0
MARS_SEMI_MINOR_RADIUS_M=3376200.0
MARS_ELEVATION_DATUM=MOLA_AREOID_GMM2B

# AI Orchestration
AI_PROVIDER=mock_fallback
AI_MODEL_NAME=gemini-1.5-pro
AI_EMBEDDING_MODEL=text-embedding-004
AI_API_KEY=

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Immediate peers allowed to set X-Forwarded-For. Empty ignores the header.
TRUSTED_PROXY_CIDRS=[]

# Frontend
# Backend used by the Vite dev server proxy for /api requests.
VITE_BACKEND_URL=http://localhost:8000
# Optional absolute API origin for production builds. Leave empty to use relative /api paths.
VITE_API_URL=
