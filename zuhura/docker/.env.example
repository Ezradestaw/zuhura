# Copy to zuhura/docker/.env before a production deployment.
# The compose file still boots for local research with the development defaults,
# and the backend logs a warning when ENVIRONMENT=production keeps those defaults.

ENVIRONMENT=development
POSTGRES_DB=zuhura
POSTGRES_USER=zuhura_user
POSTGRES_PASSWORD=replace-this-development-password
POSTGRES_PORT=5432

# Leave empty for local Redis without AUTH. Set both together in production.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# JSON list. Do not use ["*"].
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# CIDRs of reverse proxies allowed to set X-Forwarded-For. Empty ignores the header.
TRUSTED_PROXY_CIDRS=[]

# Container paths. Host mounts default to ../../zuhura-data and ../../data/mars.
DATA_REPO_ROOT=/data/zuhura
TILES_CACHE_DIR=/data/zuhura/data/tiles
MARS_DATA_ROOT=/data/mars
# ZUHURA_DATA_HOST_PATH=../../zuhura-data
# MARS_DATA_HOST_PATH=../../data/mars

BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_BACKEND_URL=http://backend:8000
