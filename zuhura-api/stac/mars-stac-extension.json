{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.zuhura.space/v1/stac/mars-extension.json",
  "title": "Mars STAC Extension",
  "description": "Standard STAC extension fields for Mars planetary datasets in Zuhura",
  "type": "object",
  "properties": {
    "mars:body": {
      "type": "string",
      "const": "Mars",
      "description": "Target celestial body"
    },
    "mars:target_crs": {
      "type": "string",
      "default": "IAU:49902",
      "description": "IAU 2015 Mars Biaxial Ellipsoid"
    },
    "mars:latitude_type": {
      "type": "string",
      "enum": ["planetocentric", "planetographic"],
      "default": "planetocentric"
    },
    "mars:longitude_direction": {
      "type": "string",
      "enum": ["east", "west"],
      "default": "east"
    },
    "mars:elevation_datum": {
      "type": "string",
      "default": "Mars Areoid (MOLA GMM-2B)"
    },
    "mars:processing_level": {
      "type": "string",
      "enum": ["raw_observation", "calibrated", "derived_product", "interpretation", "simulation"]
    }
  }
}
