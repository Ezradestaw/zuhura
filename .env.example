# ==============================================================================
# ZUHURA BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Leave unset to use the repository-relative default next to this checkout.
# DATA_REPO_ROOT=
# TILES_CACHE_DIR=
# Immediate peers allowed to set X-Forwarded-For. Empty ignores the header.
TRUSTED_PROXY_CIDRS=[]

MARS_SEMI_MAJOR_RADIUS_M=3396190.0
MARS_SEMI_MINOR_RADIUS_M=3376200.0
MARS_ELEVATION_DATUM=Mars Areoid (MOLA GMM-2B)

# Google Gemini API configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
AI_PROVIDER=gemini
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT=30.0
AI_RATE_LIMIT=60
AI_TEMPERATURE=0.2
